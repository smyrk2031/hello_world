<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 
      IIS URL Rewrite設定
      React RouterのSPAルーティングをサポート
      全てのリクエストをindex.htmlにリダイレクト
    -->
    <rewrite>
      <rules>
        <!-- PyGardenBackend → uvicorn（必ず SPA ルールより先に評価すること） -->
        <rule name="Proxy PyGardenBackend to uvicorn" stopProcessing="true">
          <match url="^PyGardenBackend(.*)" />
          <action type="Rewrite" url="http://localhost:8001{R:1}" />
        </rule>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- 実際のファイルでない場合 -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- 実際のディレクトリでない場合 -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- API・auth・static 等でない場合（/ または /PyGarden/ 配下どちらでも判定。バックエンド転送は別ルールで先に実行すること） -->
            <add input="{REQUEST_URI}" pattern="^/PyGarden/(api|auth|static|user|mycontents|gallery)/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|auth|static|user|mycontents|gallery)/" negate="true" />
          </conditions>
          <!-- index.htmlにリライト -->
          <action type="Rewrite" url="/PyGarden/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 静的ファイルのMIMEタイプ設定 -->
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- 圧縮設定 -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="text/html" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="text/html" enabled="true" />
      </staticTypes>
    </httpCompression>

    <!-- キャッシュ設定 -->
    <httpProtocol>
      <customHeaders>
        <!-- 開発時は無効化、本番時は有効化を推奨 -->
        <!-- <add name="Cache-Control" value="public, max-age=31536000" /> -->
      </customHeaders>
    </httpProtocol>

    <!-- エラーページ設定（オプション） -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
